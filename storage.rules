rules_version = '2';
// Public read for site media; only the owner's account may upload or delete.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'MD9lkeUr2rf2fOjWtn0ICVtnLSF3';
    }
  }
}
