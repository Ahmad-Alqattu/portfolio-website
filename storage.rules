rules_version = '2';
// Only the owner may list, upload or delete. Site media (public/ and the old
// portfolio-media/) is readable by URL; everything else, e.g. users/ with
// private uploads, is owner only.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'MD9lkeUr2rf2fOjWtn0ICVtnLSF3';
    }
    match /{allPaths=**} {
      allow read, write: if isOwner();
    }
    match /public/{allPaths=**} {
      allow get: if true;
    }
    match /portfolio-media/{allPaths=**} {
      allow get: if true;
    }
  }
}
